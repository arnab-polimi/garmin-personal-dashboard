[garmin]
# Official Garmin Connect Personal API (https://personal.connectapi.garmin.com)
# Generate your Personal API Key in Garmin Connect Web -> Account Settings -> Personal API Key
api_key = "GCDC_your_personal_api_key_here"

[hevy]
# Official Hevy Public API v1 (https://api.hevyapp.com/v1)
# Generate your Hevy Pro API Key at https://hevy.com/settings?developer
api_key = "your_hevy_api_key_uuid_here"
